# PathMind AI - Environment Configuration
# Copy this to .env and fill in your values

# Database (Supabase connection string)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Auth
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API (free at ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key-here

# App Settings
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Head of Academy Configuration (Optional - customize root administrator credentials)
SUPERADMIN_EMAIL=er.adityasah@gmail.com
SUPERADMIN_PASSWORD=Aditya@2005
SUPERADMIN_NAME=Head of Academy

